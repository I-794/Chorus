# Copy this file to .env.local and fill it in. Never commit .env.local.
# Every variable here is server-only: none are prefixed NEXT_PUBLIC_, so none reach the browser.

# --- Database -----------------------------------------------------------------
# Neon Postgres. Use the *pooled* connection string (host contains "-pooler").
# For local development you can also point this at a local Postgres.
DATABASE_URL=postgres://user:password@ep-example-pooler.us-east-2.aws.neon.tech/chorus?sslmode=require

# --- Auth.js --------------------------------------------------------------------
# Random secret used to sign session cookies. Generate one with: npx auth secret
AUTH_SECRET=

# Google sign-in. Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your site>/api/auth/callback/google
#   e.g. http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email sign-in links are sent with Resend (https://resend.com/api-keys).
# Without a verified domain, Resend only delivers to your own address.
AUTH_RESEND_KEY=
EMAIL_FROM="Chorus <login@yourdomain.com>"

# Only needed when NOT hosting on Vercel (Vercel sets this up automatically).
# AUTH_TRUST_HOST=true

# --- AI -----------------------------------------------------------------------------
# Vercel AI Gateway: one key for every model provider.
# Locally: create a key in the Vercel dashboard → AI Gateway → API keys.
# On Vercel: optional, deployments authenticate with OIDC automatically.
AI_GATEWAY_API_KEY=

# --- Tests (optional) -----------------------------------------------------------------
# A separate, migrated database for the limit integration tests (pnpm test).
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/chorus_test
